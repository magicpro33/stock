# Copy to secrets.toml locally, or paste as top-level keys in
# Streamlit Cloud → App settings → Secrets (not nested under a table).

# Optional. Defaults to magicpro33/stock if unset.
GITHUB_REPO = "magicpro33/stock"

# Optional. Used by live Analyze fallback and nightly_scan when Yahoo is thin.
AV_API_KEY = "your-alpha-vantage-key"

# Optional. Used by data_chain.py if you wire Alpaca later.
ALPACA_API_KEY = "your-key"
ALPACA_SECRET_KEY = "your-secret"
